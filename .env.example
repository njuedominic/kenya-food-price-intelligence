# Copy this file to .env and replace every placeholder before starting services.
# Use URL-safe hexadecimal characters for passwords used in database URLs.
POSTGRES_USER=food_platform
POSTGRES_PASSWORD=replace-me-with-a-local-url-safe-secret
POSTGRES_PORT=5433
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-me-with-a-distinct-local-secret
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_FERNET_KEY=replace-me-with-a-generated-Fernet-key
AIRFLOW_WEBSERVER_SECRET_KEY=replace-me-with-a-generated-local-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me-with-a-distinct-local-secret
